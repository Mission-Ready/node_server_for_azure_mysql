# ------------------------------------------------------------------
# TEMPLATE ONLY. DO NOT EDIT THIS FILE OR PUT REAL VALUES IN IT.
#
# The server reads `.env`, not this file. Anything you change here
# is ignored by the app and gets committed to Git.
#
# 1. Copy this file and rename it `.env`
# 2. Open `.env` and replace each <placeholder> with your own values.
# ------------------------------------------------------------------

# Azure Database for MySQL connection
MYSQL_HOST=<your-server-name>.mysql.database.azure.com
MYSQL_USER=<your-admin-username>
MYSQL_PASSWORD=<your-admin-password>
MYSQL_DATABASE=world

# Port the Node server listens on
PORT=4000
